{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A3 Concept of the day - content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "domain", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "module": { "const": "A3" },
    "domain": { "$ref": "#/$defs/domain" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/concept" }
    }
  },
  "$defs": {
    "domain": {
      "type": "string",
      "enum": [
        "ai_ml", "chemistry", "physics", "biology", "biomedicine",
        "drug_discovery", "statistics_data_science", "mathematics"
      ]
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "title", "depth", "explainer", "formula", "source", "question", "tags"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^a3-(ai_ml|chemistry|physics|biology|biomedicine|drug_discovery|statistics_data_science|mathematics)-[0-9]{4}$"
        },
        "domain": { "$ref": "#/$defs/domain" },
        "title": { "type": "string", "minLength": 3, "maxLength": 80 },
        "depth": { "type": "string", "enum": ["introductory", "intermediate", "advanced"] },
        "explainer": { "type": "string", "minLength": 600, "maxLength": 2200 },
        "formula": {
          "description": "Optional display formula as bare TeX; null when none.",
          "type": ["string", "null"],
          "maxLength": 300
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url"],
          "properties": {
            "title": { "type": "string", "minLength": 3 },
            "url": { "type": "string", "pattern": "^https://" }
          }
        },
        "question": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt", "options", "correct_option_id", "explanation"],
          "properties": {
            "prompt": { "type": "string", "minLength": 10, "maxLength": 300 },
            "options": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "text"],
                "properties": {
                  "id": { "type": "string", "enum": ["a", "b", "c", "d"] },
                  "text": { "type": "string", "minLength": 1, "maxLength": 200 }
                }
              }
            },
            "correct_option_id": { "type": "string", "enum": ["a", "b", "c", "d"] },
            "explanation": { "type": "string", "minLength": 20, "maxLength": 400 }
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}
