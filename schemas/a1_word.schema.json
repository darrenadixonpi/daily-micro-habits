{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1 Word of the day - content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "tier", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "module": { "const": "A1" },
    "tier": { "type": "integer", "enum": [1, 2, 3] },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/word" }
    }
  },
  "$defs": {
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "headword", "part_of_speech", "ipa", "definition",
        "etymology", "example_sentence", "inflections", "tier", "tags"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^a1-t[1-3]-[0-9]{4}$" },
        "headword": { "type": "string", "pattern": "^[a-z][a-z-]*$", "maxLength": 40 },
        "part_of_speech": {
          "type": "string",
          "enum": ["noun", "verb", "adjective", "adverb", "preposition", "conjunction", "interjection", "pronoun"]
        },
        "ipa": { "type": "string", "pattern": "^/.+/$", "maxLength": 60 },
        "definition": { "type": "string", "minLength": 20, "maxLength": 300 },
        "etymology": { "type": "string", "minLength": 20, "maxLength": 300 },
        "example_sentence": { "type": "string", "minLength": 20, "maxLength": 240 },
        "inflections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z-]*$" }
        },
        "tier": { "type": "integer", "enum": [1, 2, 3] },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}
