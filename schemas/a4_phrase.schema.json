{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A4 Foreign-language phrase - content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "language", "tts_voice", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "module": { "const": "A4" },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z0-9]{2,3})?$" },
    "tts_voice": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phrase" }
    }
  },
  "$defs": {
    "phrase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "phrase", "literal_translation", "idiomatic_translation",
        "usage_note", "register", "cefr", "transliteration", "tags"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^a4-[a-z0-9]+-[0-9]{4}$" },
        "phrase": { "type": "string", "minLength": 2, "maxLength": 120 },
        "literal_translation": { "type": "string", "minLength": 2, "maxLength": 200 },
        "idiomatic_translation": { "type": "string", "minLength": 2, "maxLength": 200 },
        "usage_note": { "type": "string", "minLength": 10, "maxLength": 300 },
        "register": { "type": "string", "enum": ["formal", "informal", "neutral"] },
        "cefr": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1"] },
        "transliteration": {
          "description": "Romanization for non-Latin scripts; null for Latin-script languages.",
          "type": ["string", "null"]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}
