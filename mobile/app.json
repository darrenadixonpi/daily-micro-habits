{
  "expo": {
    "name": "Micro-Habits",
    "slug": "daily-micro-habits",
    "scheme": "microhabits",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.darrendixon.dailymicrohabits",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      "expo-secure-store",
      "react-native-quick-crypto",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Micro-Habits uses Face ID to unlock your journal when App lock is on."
        }
      ],
      "./plugins/withNoPushEntitlement"
    ]
  }
}
